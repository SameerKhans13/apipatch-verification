    "/webhook_endpoints": {
      "get": {
        "summary": "List webhook endpoints",
        "operationId": "listWebhookEndpoints",
        "responses": {
          "200": {
            "description": "List of webhooks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": { "type": "string", "example": "list" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/WebhookEndpoint" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create webhook endpoint",
        "operationId": "createWebhookEndpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url", "enabled_events"],
                "properties": {
                  "url": { "type": "string" },
                  "enabled_events": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created WebhookEndpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Charge": {
        "type": "object",
        "required": ["id", "object", "amount", "currency", "paid", "status"],
        "properties": {
          "id": { "type": "string", "example": "ch_1Gs8yF2eZvKYlo2C" },
          "object": { "type": "string", "enum": ["charge"], "example": "charge" },
          "amount": { "type": "integer", "example": 2000 },
          "currency": { "type": "string", "example": "usd" },
          "paid": { "type": "boolean", "example": true },
          "status": {
            "type": "string",
            "enum": ["succeeded", "pending", "failed"],
            "example": "succeeded"
          },
          "payment_method": { "type": "string", "example": "pm_123" },
          "customer": { "type": "string", "nullable": true, "example": "cus_123" },
          "description": { "type": "string", "nullable": true, "example": "Order #1001" },
          "payment_method_details": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "example": "card" },
              "card": {
                "type": "object",
                "properties": {
                  "brand": { "type": "string", "example": "Visa" },
                  "last4": { "type": "string", "example": "4242" },
                  "exp_month": { "type": "integer", "example": 12 },
                  "exp_year": { "type": "integer", "example": 2028 }
                }
              }
            }
          }
        }
      },
      "ChargeList": {
        "type": "object",
        "required": ["object", "data", "has_more"],
        "properties": {
          "object": { "type": "string", "enum": ["list"], "example": "list" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Charge" }
          },
          "has_more": { "type": "boolean", "example": false }
        }
      },
      "CreateChargeRequest": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": { "type": "integer", "description": "Amount in cents", "example": 2000 },
          "currency": { "type": "string", "example": "usd" },
          "payment_method": { "type": "string", "description": "Payment method identifier", "example": "pm_card_visa" },
          "customer": { "type": "string", "example": "cus_123" },
          "description": { "type": "string" }
        }
      },
      "Refund": {
        "type": "object",
        "required": ["id", "object", "amount", "charge", "status"],
        "properties": {
          "id": { "type": "string", "example": "re_123" },
          "object": { "type": "string", "enum": ["refund"] },
          "amount": { "type": "integer", "example": 2000 },
          "charge": { "type": "string", "example": "ch_123" },
          "status": { "type": "string", "enum": ["succeeded", "pending", "failed", "canceled"] }
        }
      },
      "PaymentIntent": {
        "type": "object",
        "required": ["id", "object", "amount", "currency", "status", "client_secret", "payment_method_types"],
        "properties": {
          "id": { "type": "string", "example": "pi_1Gs8yF2eZvKYlo2C" },
          "object": { "type": "string", "enum": ["payment_intent"], "example": "payment_intent" },
          "amount": { "type": "integer", "example": 2000 },
          "currency": { "type": "string", "example": "usd" },
          "status": {
            "type": "string",
            "enum": [
              "requires_payment_method",
              "requires_confirmation",
              "requires_action",
              "processing",
              "requires_capture",
              "canceled",
              "succeeded"
            ],
            "example": "requires_payment_method"
          },
          "client_secret": { "type": "string", "example": "pi_1Gs8yF2eZvKYlo2C_secret_abc123" },
          "statement_descriptor_suffix": { "type": "string", "nullable": true, "example": "INV1001" },
          "capture_method": {
            "type": "string",
            "enum": ["automatic", "manual"],
            "default": "automatic",
            "example": "automatic"
          },
          "payment_method": { "type": "string", "nullable": true, "example": "pm_123" },
          "customer": { "type": "string", "nullable": true, "example": "cus_123" },
          "description": { "type": "string", "nullable": true },
          "payment_method_types": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["card", "amazon_pay", "cashapp", "revolut_pay"]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "PaymentIntentList": {
        "type": "object",
        "required": ["object", "data", "has_more"],
        "properties": {
          "object": { "type": "string", "enum": ["list"], "example": "list" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PaymentIntent" }
          },
          "has_more": { "type": "boolean", "example": false }
        }
      },
      "CreatePaymentIntentRequest": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": { "type": "integer", "example": 2000 },
          "currency": { "type": "string", "example": "usd" },
          "customer": { "type": "string" },
          "payment_method": { "type": "string" },
          "capture_method": { "type": "string", "enum": ["automatic", "manual"], "default": "automatic" },
          "description": { "type": "string" },
          "payment_method_types": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["card"]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "Customer": {
        "type": "object",
        "required": ["id", "object", "created"],
        "properties": {
          "id": { "type": "string", "example": "cus_123" },
          "object": { "type": "string", "enum": ["customer"], "example": "customer" },
          "created": { "type": "integer", "example": 1600000000 },
          "email": { "type": "string", "nullable": true, "example": "sam@example.com" },
          "name": { "type": "string", "nullable": true, "example": "Sam Developer" },
          "phone": { "type": "string", "nullable": true },
          "default_source": { "type": "string", "nullable": true, "example": "card_123" },
          "billing_details": {
            "type": "object",
            "nullable": true,
            "properties": {
              "email": { "type": "string" },
              "name": { "type": "string" },
              "address": {
                "type": "object",
                "properties": {
                  "city": { "type": "string" },
                  "country": { "type": "string" },
                  "line1": { "type": "string" },
                  "postal_code": { "type": "string" }
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "CustomerList": {
        "type": "object",
        "required": ["object", "data", "has_more"],
        "properties": {
          "object": { "type": "string", "enum": ["list"] },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Customer" }
          },
          "has_more": { "type": "boolean" }
        }
      },
      "CreateCustomerRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "name": { "type": "string" },
          "payment_method": { "type": "string" },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "DeletedCustomer": {
        "type": "object",
        "required": ["id", "object", "deleted"],
        "properties": {
          "id": { "type": "string", "example": "cus_123" },
          "object": { "type": "string", "enum": ["customer"] },
          "deleted": { "type": "boolean", "example": true }
        }
      },
      "Subscription": {
        "type": "object",
        "required": ["id", "object", "customer", "status", "current_period_start", "current_period_end", "items"],
        "properties": {
          "id": { "type": "string", "example": "sub_123" },
          "object": { "type": "string", "enum": ["subscription"] },
          "customer": { "type": "string", "example": "cus_123" },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "past_due",
              "unpaid",
              "canceled",
              "incomplete",
              "incomplete_expired",
              "trialing",
              "paused"
            ]
          },
          "current_period_start": { "type": "integer", "example": 1600000000 },
          "current_period_end": { "type": "integer", "example": 1602678400 },
          "items": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "price": { "type": "string" },
                    "quantity": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "SubscriptionList": {
        "type": "object",
        "required": ["object", "data", "has_more"],
        "properties": {
          "object": { "type": "string", "enum": ["list"] },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Subscription" }
          },
          "has_more": { "type": "boolean" }
        }
      },
      "CreateSubscriptionRequest": {
        "type": "object",
        "required": ["customer", "items"],
        "properties": {
          "customer": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["price"],
              "properties": {
                "price": { "type": "string" },
                "quantity": { "type": "integer", "default": 1 }
              }
            }
          }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "required": ["id", "object", "url", "enabled_events", "status"],
        "properties": {
          "id": { "type": "string", "example": "we_123" },
          "object": { "type": "string", "enum": ["webhook_endpoint"] },
          "url": { "type": "string", "example": "https://api.example.com/webhook" },
          "enabled_events": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": { "type": "string", "example": "enabled" },
          "secret": { "type": "string", "example": "whsec_test_secret" }
        }
      },
      "Event": {
        "type": "object",
        "required": ["id", "object", "api_version", "created", "data", "type"],
        "properties": {
          "id": { "type": "string", "example": "evt_123" },
          "object": { "type": "string", "enum": ["event"] },
          "api_version": { "type": "string", "example": "2024-06-20" },
          "created": { "type": "integer", "example": 1600000000 },
          "type": { "type": "string", "example": "payment_intent.succeeded" },
          "data": {
            "type": "object",
            "required": ["object"],
            "properties": {
              "object": {
                "type": "object",
                "description": "The specific resource payload for this event"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["message", "type"],
            "properties": {
              "message": { "type": "string", "example": "No such charge: ch_invalid" },
              "type": { "type": "string", "example": "invalid_request_error" },
