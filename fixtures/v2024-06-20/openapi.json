      }
    },
    "/payment_intents/{id}": {
      "get": {
        "summary": "Retrieve a payment intent",
        "operationId": "getPaymentIntent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PaymentIntent object",
            "content": {
