  "components": {
    "schemas": {
      "Charge": {
        "type": "object",
        "required": ["id", "object", "amount", "paid", "status"],
        "properties": {
          "id": { "type": "string", "example": "ch_1Gs8yF2eZvKYlo2C" },
          "object": { "type": "string", "enum": ["charge"], "example": "charge" },
          "amount": { "type": "integer", "example": 2000 },
          "currency": {
            "type": "string",
            "nullable": true,
            "description": "Category 14: Non-nullable field changed to nullable"
          },
          "pricing": {
            "type": "object",
            "description": "Category 7: Flat field currency nested inside pricing object",
            "properties": {
              "currency": { "type": "string", "example": "usd" },
              "unit_amount": { "type": "integer", "example": 2000 }
            }
          },
          "paid": { "type": "boolean", "example": true },
          "status": {
            "type": "string",
            "enum": ["succeeded", "pending", "failed"],
            "example": "succeeded"
          },
          "payment_method": { "type": "string", "example": "pm_123" },
          "customer": { "type": "string", "nullable": true, "example": "cus_123" },
          "description": { "type": "string", "nullable": true, "example": "Order #1001" }
        }
      },
      "BrokenChargeList": {
        "type": "object",
        "description": "Category 11: Pagination shape changed from object=list/data/has_more to object=page/items/has_next_page/next_cursor",
        "required": ["object", "items", "has_next_page"],
        "properties": {
          "object": { "type": "string", "enum": ["page"], "example": "page" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Charge" }
          },
          "has_next_page": { "type": "boolean", "example": false },
          "next_cursor": { "type": "string", "nullable": true, "example": "cur_123" }
        }
      },
      "Refund": {
        "type": "object",
        "required": ["id", "object", "amount", "charge", "status"],
        "properties": {
          "id": { "type": "string", "example": "re_123" },
          "object": { "type": "string", "enum": ["refund"] },
          "amount": { "type": "integer", "example": 2000 },
          "charge": { "type": "string", "example": "ch_123" },
          "status": { "type": "string", "enum": ["succeeded", "pending", "failed", "canceled"] }
        }
      },
      "BrokenPaymentIntent": {
        "type": "object",
        "description": "PaymentIntent with deliberate injected breaking changes",
        "required": ["id", "object", "amount", "currency", "status", "payment_method_types", "description"],
        "properties": {
          "id": { "type": "string", "example": "pi_1Gs8yF2eZvKYlo2C" },
          "object": { "type": "string", "enum": ["payment_intent"], "example": "payment_intent" },
          "amount": {
            "type": "string",
            "description": "Category 3: Field type changed from integer (cents) to string (e.g. '20.00')",
            "example": "20.00"
          },
          "currency": { "type": "string", "example": "usd" },
          "status": {
            "type": "string",
            "description": "Category 5: Enum values 'requires_action' and 'canceled' removed from stable status list",
            "enum": [
              "requires_payment_method",
              "requires_confirmation",
              "processing",
              "requires_capture",
              "succeeded"
            ],
            "example": "requires_payment_method"
          },
          "capture_method": {
            "type": "string",
            "description": "Category 16: Default value change from 'automatic' to 'manual' (semantic breaking)",
            "enum": ["automatic", "manual"],
            "default": "manual",
            "example": "manual"
          },
          "payment_method": { "type": "string", "nullable": true, "example": "pm_123" },
          "customer": { "type": "string", "nullable": true, "example": "cus_123" },
          "description": {
            "type": "string",
            "nullable": false,
            "description": "Category 14: Nullable field changed to non-nullable (and now required in response)"
          },
          "payment_method_types": {
            "type": "string",
            "description": "Category 15: Array of strings changed to single string",
            "example": "card"
          },
          "metadata": {
            "type": "string",
            "description": "Category 3: Field type changed from Record<string, string> object to raw JSON string blob",
            "example": "{\"order_id\":\"1234\"}"
          }
        }
      },
      "BrokenPaymentIntentList": {
        "type": "object",
        "description": "Category 11: Broken pagination response envelope",
        "required": ["object", "items", "has_next_page"],
        "properties": {
          "object": { "type": "string", "enum": ["page"], "example": "page" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BrokenPaymentIntent" }
          },
          "has_next_page": { "type": "boolean", "example": false },
          "next_cursor": { "type": "string", "nullable": true }
        }
      },
      "BrokenCreatePaymentIntentRequest": {
        "type": "object",
        "description": "Category 4: Required currency made optional, and optional receipt_email made required. Category 2: customer parameter renamed to customer_id",
        "required": ["amount", "receipt_email"],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Category 3: Type changed from integer to string",
            "example": "20.00"
          },
          "currency": {
            "type": "string",
            "description": "Category 4: Previously required field now optional (non-breaking)",
            "example": "usd"
          },
          "receipt_email": {
            "type": "string",
            "description": "Category 4: Previously optional field now required (breaking)",
            "example": "receipts@example.com"
          },
          "customer_id": {
            "type": "string",
            "description": "Category 2: Parameter customer renamed to customer_id",
            "example": "cus_123"
          },
          "payment_method": { "type": "string" },
          "capture_method": {
            "type": "string",
            "enum": ["automatic", "manual"],
            "default": "manual",
            "description": "Category 16: Default value changed from automatic to manual"
          },
          "payment_method_types": {
            "type": "string",
            "description": "Category 15: Array changed to single string",
            "example": "card"
          },
          "metadata": {
            "type": "string",
            "description": "Category 3: Object changed to JSON string"
          }
        }
      },
      "BrokenCustomer": {
        "type": "object",
        "required": ["id", "object", "created"],
        "properties": {
          "id": { "type": "string", "example": "cus_123" },
          "object": { "type": "string", "enum": ["customer"], "example": "customer" },
          "created": { "type": "integer", "example": 1600000000 },
          "email": { "type": "string", "nullable": true, "example": "sam@example.com" },
          "name": { "type": "string", "nullable": true, "example": "Sam Developer" },
          "phone": { "type": "string", "nullable": true },
          "default_payment_source_id": {
            "type": "string",
            "nullable": true,
            "description": "Category 2: default_source renamed to default_payment_source_id",
            "example": "card_123"
          },
          "billing_address_city": {
            "type": "string",
            "description": "Category 7: Flattened from billing_details.address.city"
          },
          "billing_address_country": {
            "type": "string",
            "description": "Category 7: Flattened from billing_details.address.country"
          },
          "account_status": {
            "type": "string",
            "description": "Category 6: Added new enum values 'suspended' and 'pending_approval' (non-breaking addition)",
            "enum": ["active", "suspended", "pending_approval"],
            "default": "active"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "BrokenCustomerList": {
        "type": "object",
        "required": ["object", "items", "has_next_page"],
        "properties": {
          "object": { "type": "string", "enum": ["page"] },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BrokenCustomer" }
          },
          "has_next_page": { "type": "boolean" }
        }
      },
      "CreateCustomerRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "name": { "type": "string" },
          "payment_method": { "type": "string" },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "DeletedCustomer": {
        "type": "object",
        "required": ["id", "object", "deleted"],
        "properties": {
          "id": { "type": "string", "example": "cus_123" },
          "object": { "type": "string", "enum": ["customer"] },
          "deleted": { "type": "boolean", "example": true }
        }
      },
      "Subscription": {
        "type": "object",
        "required": ["id", "object", "customer", "status", "current_period_start", "current_period_end", "line_item"],
        "properties": {
          "id": { "type": "string", "example": "sub_123" },
          "object": { "type": "string", "enum": ["subscription"] },
          "customer": { "type": "string", "example": "cus_123" },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "past_due",
              "unpaid",
              "canceled",
              "incomplete",
              "incomplete_expired",
              "trialing",
              "paused"
            ]
          },
          "current_period_start": { "type": "integer", "example": 1600000000 },
          "current_period_end": { "type": "integer", "example": 1602678400 },
          "line_item": {
            "type": "object",
            "description": "Category 15: items array changed to single line_item object",
            "required": ["price", "quantity"],
            "properties": {
              "price": { "type": "string" },
              "quantity": { "type": "integer" }
            }
          }
        }
      },
      "BrokenSubscriptionList": {
        "type": "object",
        "required": ["object", "items", "has_next_page"],
        "properties": {
          "object": { "type": "string", "enum": ["page"] },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Subscription" }
          },
          "has_next_page": { "type": "boolean" }
        }
      },
      "BrokenCreateSubscriptionRequest": {
        "type": "object",
        "description": "Category 15: items array changed to single item object",
        "required": ["customer", "item"],
        "properties": {
          "customer": { "type": "string" },
          "item": {
            "type": "object",
            "required": ["price"],
            "properties": {
              "price": { "type": "string" },
              "quantity": { "type": "integer", "default": 1 }
            }
          }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "required": ["id", "object", "url", "enabled_events", "status"],
        "properties": {
          "id": { "type": "string", "example": "we_123" },
          "object": { "type": "string", "enum": ["webhook_endpoint"] },
          "url": { "type": "string", "example": "https://api.example.com/webhook" },
          "enabled_events": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": { "type": "string", "example": "enabled" },
          "secret": { "type": "string", "example": "whsec_test_secret" }
        }
      },
      "BrokenEvent": {
        "type": "object",
        "description": "Category 13: Webhook event payload schema for data.object changed to BrokenPaymentIntent",
        "required": ["id", "object", "api_version", "created", "data", "type"],
        "properties": {
          "id": { "type": "string", "example": "evt_123" },
          "object": { "type": "string", "enum": ["event"] },
          "api_version": { "type": "string", "example": "2024-06-20-BROKEN" },
          "created": { "type": "integer", "example": 1600000000 },
          "type": { "type": "string", "example": "payment_intent.succeeded" },
          "data": {
            "type": "object",
            "required": ["object"],
            "properties": {
              "object": {
                "$ref": "#/components/schemas/BrokenPaymentIntent",
