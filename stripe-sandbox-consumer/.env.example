# GitHub Personal Access Token (PAT)
# Required for `apipatch publish` to create topic branches and open Pull Requests on GitHub.
# Token format: ghp_xxxxxxxxxxxxxxxxxxxx or github_pat_xxxxxxxxxxxxxxxxxxxx
# Required Scopes / Permissions:
#   - Classic PAT: `repo` (Full control of private repositories) or `public_repo`
#   - Fine-Grained PAT: Repository permissions -> Contents (Read & Write), Pull Requests (Read & Write)
GITHUB_TOKEN=your_github_personal_access_token_here

# Optional: Alternative GitHub Token variable name
GH_TOKEN=

# Optional: Stripe API Secret Key (defaults to mock test key if omitted)
STRIPE_SECRET_KEY=sk_test_mock_secret_key
